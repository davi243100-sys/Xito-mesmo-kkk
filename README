            box-sizing: border-box;
        }

        input::placeholder { color: #666; }

        /* BOTÃO PRINCIPAL */
        button.main-btn { 
            background: linear-gradient(45deg, #cc0000, #ff0000); 
            color: white; 
            font-weight: bold; 
