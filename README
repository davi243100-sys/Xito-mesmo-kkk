        }

        .key-info { display: flex; flex-direction: column; align-items: flex-start; }
        .key-text { font-family: monospace; font-weight: bold; letter-spacing: 1px; }
        .status-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 5px; }
        .dot-active { background-color: #0f0; box-shadow: 0 0 5px #0f0; }
        .dot-revoked { background-color: #f00; }

        /* BOTÕES DA LISTA */
