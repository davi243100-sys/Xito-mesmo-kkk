            word-break: break-all;
            font-family: monospace;
            font-size: 18px;
            color: #0f0;
            display: none; /* Escondido até gerar */
        }

        /* LISTA DE ADMIN */
        h3 { text-align: left; border-bottom: 1px solid #333; padding-bottom: 5px; margin-top: 30px; }
        .key-list { text-align: left; margin-top: 10px; max-height: 350px; overflow-y: auto; padding-right: 5px; }
        
